# vibepanel as a user service.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/vibepanel.service ~/.config/systemd/user/
#   cp deploy/vibepanel.env ~/.config/vibepanel.env   # then edit it
#   systemctl --user daemon-reload
#   systemctl --user enable --now vibepanel
#   loginctl enable-linger "$USER"    # so it survives logout
#
# A *user* service, not a system one. The panel runs your agents as you, with
# your SSH keys, your credentials and your dotfiles. Running it as root or as a
# dedicated account would mean either handing that account your whole
# environment or having agents that cannot do anything.

[Unit]
Description=vibepanel — a web console for parallel coding sessions
Documentation=https://github.com/jiangmuran/vibepanel
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/vibepanel serve
EnvironmentFile=-%h/.config/vibepanel.env
Restart=always
RestartSec=3

# 143 is 128+15, a clean shutdown on SIGTERM. Without this the unit is left
# looking "failed" after every ordinary stop, and the next person reading
# `systemctl --user list-units` spends ten minutes on a failure that never was.
SuccessExitStatus=143

# Stopping detaches from tmux and the sessions carry on regardless, but it is
# not instant: a tmux client does not exit when its PTY closes, so each one has
# to be killed on a two-second timer. Those run concurrently, so a stop costs
# about two seconds whether one session is attached or thirty.
#
# It used to be two seconds *each*, serially — 16s at eight sessions, past this
# timeout at eleven. Every restart on a panel in real use was a SIGKILL, and
# because 137 is not the SuccessExitStatus above, a unit reported as failed.
# KillMode=process is why that cost nothing worse than a confusing status.
TimeoutStopSec=20

# The single line that makes the previous sentence true.
#
# The panel deliberately never owns a PTY that a session's process is a child
# of, so nothing in the code ties a session's life to the panel's. systemd ties
# it right back. tmux's server is started by the panel, and although it
# daemonises and re-parents, cgroup membership does not change on re-parenting
# — so the tmux server sits in this unit's cgroup, and the default
# KillMode=control-group SIGTERMs everything in it on stop.
#
# Measured on a throwaway unit and socket, two sessions, `systemctl --user
# stop`:
#
#   KillMode default (control-group) -> 2 sessions before, 0 after
#   KillMode=process                 -> 2 sessions before, 2 after
#   KillMode=mixed                   -> 2 sessions before, 0 after
#
# So `systemctl restart vibepanel` was destroying every running agent, which is
# the exact outcome the whole tmux architecture exists to prevent, arriving
# through the deployment instead of through the code.
#
# `mixed` is the trap: it reads like the careful middle option and it kills
# them too, because after the main process exits the SIGKILL phase still goes
# to the whole cgroup. Only `process` leaves the tmux server alone.
KillMode=process

# Deliberately little filesystem sandboxing.
#
# The obvious hardening — ProtectSystem=strict, ProtectHome, a narrow
# ReadWritePaths — is wrong here. The panel's whole job is to run coding agents
# as you, and those agents write to your repositories, your caches and your
# home directory. Locking that down does not make the panel safer; it makes it
# useless, and the first thing anyone would do is delete these lines.
#
# That is now the whole rule rather than an exception to one: **this unit
# confines nothing a shell can notice.**
#
# `KillMode=process` means the tmux server outlives the panel, and it also
# means the tmux server *starts inside this unit*: same cgroup, same
# namespaces, same no-new-privileges bit. So does every agent in every session,
# and every command anybody types into one. Whatever this unit does to confine
# a Go web server, it does to whatever the person at the keyboard runs — who
# did not ask for it and, in one of the cases below, cannot undo it.
#
# Three outages, each found by a person rather than by a test:
#
#   ProtectClock / ProtectKernelModules / RestrictSUIDSGID
#
#     tar: deploy: Cannot mkdir: Function not implemented
#
#   ENOSYS, not EPERM: systemd implements these with seccomp, and such a filter
#   rejects syscalls the libseccomp it was built against does not know. This
#   box runs Linux 7.0 against libseccomp 2.6, so `tar -xzf` of any archive
#   with a subdirectory in it failed in every session the panel had created.
#   Bisected with `systemd-run --user -p <directive>=yes tar -xzf`, and
#   confirmed by the same extraction succeeding in a unit with none of them.
#
#   NoNewPrivileges=yes
#
#     sudo: The "no new privileges" flag is set, which prevents sudo from
#     running as root.
#
#   Inherited by every descendant and impossible to drop once set, so no
#   session the panel opened could use sudo, su, pkexec, newgrp, or any setuid
#   or file-capability binary — `ping` included. The comment that used to be
#   here kept this one on the grounds that it installs no seccomp filter. True,
#   and beside the point: it is not a syscall rule, it is a permanent property
#   of the process tree.
#
#   ProtectControlGroups=yes
#
#   Not reported by anyone; removed with the others instead of waiting for it.
#   It mounts /sys/fs/cgroup read-only in a namespace every session inherits,
#   which is where rootless podman and anything else driving cgroupfs by hand
#   writes. It protected nothing: this process never touches cgroups.
#
# TestNothingInEitherUnitConfinesWhatAShellDoes is what keeps this true, and it
# carries the same list with the same reasons, because the next person to add
# one of these will have a good reason and needs to know what it costs.
#
# What remains below — MemoryAccounting, OOMPolicy, the weights — is about the
# machine surviving a runaway agent rather than about confining one, and a
# session cannot tell it is there.

# Not ProtectClock, and not ProtectKernelModules. They are the two on that list
# that a *user* manager cannot apply, and applying them does not fail softly:
#
#   vibepanel.service: Failed to drop capabilities: Operation not permitted
#   Failed at step CAPABILITIES spawning .../vibepanel
#   status=218/CAPABILITIES
#
# Both work by shrinking CapabilityBoundingSet -- ProtectClock drops CAP_SYS_TIME
# and CAP_WAKE_ALARM, ProtectKernelModules drops CAP_SYS_MODULE -- and shrinking
# the bounding set needs CAP_SETPCAP, which a per-user systemd does not have. So
# the unit never starts, on any machine, and it did not: this file was shipped,
# installed and documented for weeks before anybody ran `systemctl --user start`
# on it, because install-check drives a stub systemctl and never executes a unit.
#
# They also buy nothing here. A user process cannot set the clock or load a
# module whatever the bounding set says; these two are hardening that only means
# something to a unit that starts privileged. deploy/vibepanel-system.service
# does start privileged, so it keeps them -- and that is the difference between
# the two files, not an oversight in this one.
#
# ProtectKernelTunables stays: it is documented as implying a capability drop
# too, and was measured to start clean in a user unit here. Measure before
# adding another; the list above is what was tested, one directive at a time,
# in a real unit file under a real user manager.

# Not UMask=0077 either, and for the same reason: it is inherited, so every
# file every agent created came out 600 and every directory 700. A shared
# checkout, `python -m http.server`, a build step under another account —
# all quietly wrong, with nothing to point at.
#
# What that line was protecting is the database, which holds password hashes
# and passkey material. That belongs to the database: store.Open chmods it and
# its -wal and -shm to 0600 and the data directory to 0700 on every open, so
# the mode is a property of the file rather than of whichever umask the process
# happened to start with. TestTheDatabaseIsNotReadableByOthers keeps it true,
# and it is now true for `vibepanel serve` run by hand as well — which the
# unit's UMask never covered.

# Memory accounting so a runaway session is visible and bounded, rather than
# taking the machine into swap and dragging everything down with it. Tune to
# the box: these suit a 32 GB machine running a dozen agents.
# Priority, in the two forms a *user* service can actually have.
#
# Not OOMScoreAdjust. Measured, because it verifies clean and does nothing:
#
#   a user unit with OOMScoreAdjust=-500  ->  the process reads 100
#   a system unit with User= and the same ->  the process reads -500
#
# Lowering oom_score_adj needs CAP_SYS_RESOURCE, which a user manager does not
# have, and `systemd-analyze verify` accepts the directive either way. If the
# machine runs close to its memory, use deploy/vibepanel-system.service, which
# sets it before dropping to User= and therefore can.
#
# CPUWeight and IOWeight are cgroup v2 knobs and need no privileges. Negative
# Nice= would; positive is allowed and is the wrong direction.
CPUWeight=200
IOWeight=200
ManagedOOMPreference=avoid

MemoryAccounting=yes
MemoryHigh=20G
MemoryMax=26G

# When a session's process is killed for memory, only that process should die.
# Without this systemd takes down the panel — and with it every other session.
OOMPolicy=continue

[Install]
WantedBy=default.target
