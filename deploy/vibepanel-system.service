# The system unit: for when the panel has to survive a memory squeeze.
#
#   sudo cp vibepanel-system.service /etc/systemd/system/vibepanel.service
#   sudo sed -i "s/__USER__/$USER/g; s#__HOME__#$HOME#g; s#__BIN__#/usr/local/bin/vibepanel#g" \
#     /etc/systemd/system/vibepanel.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now vibepanel
#
# Why this exists alongside the user unit, measured rather than assumed:
#
#   a user unit with OOMScoreAdjust=-500  ->  the process reads 100
#   a system unit with User= and the same ->  the process reads -500
#
# Lowering oom_score_adj needs CAP_SYS_RESOURCE. A user manager runs as you and
# does not have it, so the kernel refuses -- and `systemd-analyze verify` accepts
# the directive either way, which is the worst combination: a setting that looks
# applied, passes its own check, and does nothing. A system unit sets it before
# dropping to User=, which is why it works there and only there.
#
# What it buys, and what it does not. The panel is small and must stay up; the
# tmux server it starts inherits this score and holds every session, which is
# the thing actually worth protecting. So do the agents, and that is the cost:
# an agent that eats the machine is protected too. MemoryMax below is what
# bounds that -- the cgroup's own OOM killer picks the largest process inside,
# which is the runaway agent rather than tmux or the panel.
#
# The user unit remains the right default. Use this one if the machine runs
# close to its memory, or if you want the panel up before anyone logs in
# without setting up lingering.

[Unit]
Description=vibepanel — a web console for parallel coding sessions
Documentation=https://github.com/jiangmuran/vibepanel
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
# systemd sets $HOME from the passwd entry for User=, but the panel is also
# started by hand and by the installer, and an explicit value is one fewer thing
# that differs between those paths.
Environment=HOME=__HOME__
ExecStart=__BIN__ serve
EnvironmentFile=-__HOME__/.config/vibepanel.env
WorkingDirectory=__HOME__

Restart=always
RestartSec=3
# The panel exits 0 on SIGTERM; 143 is what systemd sees when it does not get
# the chance to.
SuccessExitStatus=143
TimeoutStopSec=20

# KillMode=process is the whole architecture in one line. On stop, systemd kills
# the panel and leaves everything else in the cgroup alone -- which is the tmux
# server and every agent under it. Change this to the default (control-group)
# and `systemctl restart` becomes destructive: the sessions the panel exists to
# outlive would die with it.
KillMode=process

# The reason this file exists. Measured: -500 here, 100 in a user unit.
OOMScoreAdjust=-500
# A hint to systemd-oomd, which is a different mechanism from the kernel's own
# killer and not running on every distribution. Harmless where it is absent.
ManagedOOMPreference=avoid
# Above the default 100, so the panel and the agents get scheduled ahead of
# background work when the machine is contended. Weights, not nice levels:
# negative nice needs privileges the service does not keep after User=.
CPUWeight=200
IOWeight=200

# No sandboxing, on this unit or the user one, and that is the rule rather
# than a list of exceptions to it: **the unit confines nothing a shell can
# notice.**
#
# `KillMode=process` means the tmux server outlives the panel, and it also
# means the tmux server *starts inside this unit*: same cgroup, same
# namespaces, same no-new-privileges bit. So does every agent in every session,
# and every command anybody types into one. Whatever confines the Go web server
# confines whatever the person at the keyboard runs.
#
# Three outages, each found by a person rather than by a test:
#
#   ProtectClock / ProtectKernelModules / RestrictSUIDSGID
#
#     tar: deploy: Cannot mkdir: Function not implemented
#
#   ENOSYS, not EPERM: systemd implements these with seccomp, and such a filter
#   rejects syscalls the libseccomp it was built against does not know (Linux
#   7.0 against libseccomp 2.6 here). `tar -xzf` of any archive with a
#   subdirectory failed in every session the panel had created. Bisected with
#   `systemd-run --user -p <directive>=yes tar -xzf`.
#
#   NoNewPrivileges=yes
#
#     sudo: The "no new privileges" flag is set, which prevents sudo from
#     running as root.
#
#   Inherited by every descendant and impossible to drop once set: no session
#   could use sudo, su, pkexec, newgrp, or any setuid or file-capability
#   binary. It was kept here on the grounds that it installs no seccomp filter,
#   which is true and beside the point — it is a permanent property of the
#   process tree, not a syscall rule. It costs more on this unit than on the
#   user one, because a system unit is where somebody would most want it; the
#   answer is that this unit drops to User= before running anything, and the
#   thing it would protect against is the same person's own sudo.
#
#   ProtectControlGroups=yes
#
#   Removed with the others rather than waiting for the report. It mounts
#   /sys/fs/cgroup read-only in a namespace every session inherits, which is
#   where rootless podman and anything else driving cgroupfs by hand writes.
#
# Not UMask=0077 either: inherited, so every file every agent wrote came out
# 600. The database it was protecting now sets its own mode — store.Open chmods
# it and its -wal and -shm to 0600 and the data directory to 0700 on every
# open, which also covers `vibepanel serve` run by hand.

# Not MemoryHigh, and this is the fourth entry on the list above rather than a
# separate decision.
#
# MemoryHigh is a *sustained throttle*: the kernel keeps the cgroup at that
# figure by reclaiming and swapping, indefinitely, and everything in the cgroup
# pays. Everything in the cgroup is the tmux server, every agent, and every
# command anybody types -- so an agent doing real work throttles the panel that
# is meant to show you the agent. Measured, from the unit's own accounting:
#
#   Consumed 13min 41s CPU over 7min 39s wall,
#   20G memory peak, 3.1G memory swap peak
#
# 20G is exactly the figure that was set here. The panel stopped answering in
# time and the proxy in front of it returned intermittent 502s, which is a
# console that becomes unreachable precisely when there is something worth
# looking at.
#
# MemoryMax stays, and it is what the original reasoning was actually about: a
# hard ceiling so a runaway session cannot take the machine into swap and drag
# everything else down with it. It bites once, at the end, on the process that
# did it -- OOMPolicy=continue below is what keeps that from taking the panel
# with it. A ceiling is not a throttle.
#
# If the *panel* itself ever needs a limit of its own, the place for it is the
# panel: GOMEMLIMIT in this unit's environment bounds its heap and cannot touch
# anything it hosts. Nothing measured says it needs one -- it sits at about
# half a gigabyte -- so there is none.
MemoryAccounting=yes
MemoryMax=26G
# Do not stop the unit because something inside it was OOM-killed. The panel
# and the tmux server are usually not the victim -- an agent is -- and taking
# the whole thing down over that would turn one dead agent into all of them.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
