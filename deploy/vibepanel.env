# Environment for vibepanel. Copy to ~/.config/vibepanel.env and edit.
#
# Every setting also exists as a flag; the flag wins. See `vibepanel --help`.

# Where to listen. A non-standard port is fine — WebAuthn ignores the port when
# deciding the Relying Party ID.
VIBEPANEL_ADDR=:18443

# The public hostname. Also the WebAuthn Relying Party ID, which is why it has
# to be a name: an IP address is never valid there, whatever the TLS setup.
#VIBEPANEL_DOMAIN=panel.example.com

# off | files | acme
#VIBEPANEL_TLS_MODE=acme

# For tls=files. Reloaded when they change, so an external renewal needs no
# restart.
#VIBEPANEL_CERT_FILE=/etc/ssl/panel.pem
#VIBEPANEL_KEY_FILE=/etc/ssl/panel.key

# For tls=acme. DNS-01, because HTTP-01 needs port 80.
#VIBEPANEL_ACME_DNS_PROVIDER=cloudflare
#VIBEPANEL_ACME_EMAIL=you@example.com
#CLOUDFLARE_API_TOKEN=...
# Point at the staging directory while testing; the production rate limits are
# strict enough that a retry loop locks the domain out for a week.
#VIBEPANEL_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Narrow who may reach the panel at all. Empty allows everything.
#VIBEPANEL_ALLOW_FROM=192.168.8.0/24,10.0.0.0/8

# Believe X-Forwarded-For only from these. Leave unset when the panel is the
# edge — trusting it otherwise lets anyone bypass the login throttle.
#VIBEPANEL_TRUSTED_PROXIES=127.0.0.1/32

# Keep this dedicated: it is what stops the panel seeing, resizing or killing
# your own tmux sessions.
#VIBEPANEL_TMUX_SOCKET=vibepanel
