# Build output
/vibepanel
/dist/
/web/dist/
# Any depth, not just web's. A vitest run started from the repository root
# leaves a node_modules/.vite cache here, and `git add -A` committed it.
node_modules/

# tsc's incremental cache. Swept in by the bulk commit that added the
# frontend, and rewritten by every `tsc -b` — so the tree was dirty after
# every build, which is how a `git status` stops being read.
/web/*.tsbuildinfo

# Runtime data — never commit a database with real session/credential data
/data/
*.db
*.db-wal
*.db-shm

# Local config & secrets
.env
.env.local

# Editor
.DS_Store
*.swp

# Render-check screenshots
/web/shots/

# Release archives
/dist/

# Claude Code session state — a lock file with a pid in it, swept in by a
# bulk commit. Nothing here belongs to the project.
/.claude/

# Screenshots the render checks paste into a project to prove the upload path
# works. They land in whatever directory the check pointed at, and one of them
# reached a commit.
web/pasted-*.png
