{
  "plugin": 1,
  "id": "__ID__",
  "name": {
    "en": "__NAME__"
  },
  "version": "0.1.0",
  "panels": [
    {
      "slot": "sidepanel.pane",
      "entry": "pane.html",
      "title": {
        "en": "__NAME__"
      },
      "icon": "activity"
    }
  ],
  "capabilities": [
    "read:panel"
  ],
  "data": {
